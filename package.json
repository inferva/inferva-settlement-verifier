{
  "name": "@inferva/settlement-verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Specification and independent verifier for the INFERVA settlement log hash chain.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://inferva.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inferva/inferva-settlement-verifier.git"
  },
  "bugs": "https://github.com/inferva/inferva-settlement-verifier/issues",
  "keywords": [
    "inferva",
    "settlement",
    "hash-chain",
    "sha-256",
    "verifier",
    "golden-vectors"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "bin": {
    "inferva-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vectors",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "vectors": "tsx scripts/gen-vectors.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
